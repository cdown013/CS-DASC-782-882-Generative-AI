    "## 0. Parameters"
   ]
  },
  {
   "cell_type": "code",
   "id": "cell-04",
   "metadata": {},
   "source": [
    "IMAGE_SIZE = 64\n",
    "CHANNELS = 1           # Fashion-MNIST is grayscale (Foster uses 3 for CelebA)\n",
    "BATCH_SIZE = 512\n",
    "Z_DIM = 128\n",
    "LEARNING_RATE = 0.0002\n",
    "ADAM_BETA_1 = 0.5\n",
    "ADAM_BETA_2 = 0.999\n",
    "CRITIC_STEPS = 3       # critic updates per generator update\n",
    "GP_WEIGHT = 10.0\n",
    "STEPS_PER_EPOCH = 2    # as in Foster: an \"epoch\" is only 2 generator updates\n",
    "\n",
    "EPOCHS = 3000          # 3000 epochs x 2 = 6,000 generator steps (18,000 critic steps)\n",
    "SAMPLE_EVERY = 100     # epochs between saved sample grids / diversity checks\n",
    "N_DIVERSITY = 500      # images used for the diversity metric\n",
    "\n",
    "QUICK_TEST = False     # set True for a few-minute check that everything runs\n",
    "if QUICK_TEST:\n",
    "    EPOCHS, SAMPLE_EVERY = 40, 10\n",
    "\n",
    "OUTPUT_DIR = \"output\"\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "id": "cell-05",
   "metadata": {},
   "source": [
    "## 1. Data and helpers"
   ]
  },
  {
   "cell_type": "code",
   "id": "cell-06",
   "metadata": {},
   "source": [
    "def to_unit(images):\n",
    "    \"\"\"Map images from [-1, 1] to [0, 1] for display.\"\"\"\n",
    "    return np.clip((np.asarray(images) + 1.0) / 2.0, 0.0, 1.0)\n",
    "\n",
    "\n",
    "def plot_grid(images, nrows, ncols, title=None, path=None, show=True):\n",
    "    images = to_unit(images)\n",
    "    fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * 1.5, nrows * 1.5))\n",
    "    for ax, img in zip(np.ravel(axes), images):\n",
    "        ax.imshow(img.squeeze(), cmap=\"gray\", vmin=0, vmax=1)\n",
    "    for ax in np.ravel(axes):\n",
    "        ax.axis(\"off\")\n",
    "    if title:\n",
    "        fig.suptitle(title)\n",
    "    fig.tight_layout()\n",
    "    if path:\n",
    "        fig.savefig(path, dpi=120, bbox_inches=\"tight\")\n",
    "    if show:\n",
    "        plt.show()\n",
    "    plt.close(fig)\n",
    "\n",
    "\n",
    "def mean_pairwise_distance(images):\n",
    "    \"\"\"Mean L2 distance over all pairs of images (pixels in [0, 1]).\n",
    "\n",
    "    A mode-collapsed generator produces near-duplicate images, so its value\n",
    "    falls well below the value for real data.\n",
    "    \"\"\"\n",
    "    x = to_unit(images).reshape(len(images), -1).astype(\"float64\")\n",
    "    sq = np.sum(x ** 2, axis=1)\n",
    "    d2 = np.maximum(sq[:, None] + sq[None, :] - 2.0 * x @ x.T, 0.0)\n",
    "    return float(np.sqrt(d2)[np.triu_indices(len(x), k=1)].mean())"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "id": "cell-07",
   "metadata": {},
   "source": [
    "(x_train, _), (x_test, _) = keras.datasets.fashion_mnist.load_data()\n",
    "x_all = np.concatenate([x_train, x_test])  # (70000, 28, 28) uint8\n",
    "print(\"Fashion-MNIST images:\", x_all.shape)\n",
    "\n",
    "\n",
    "def preprocess(img):\n",
    "    img = tf.cast(img, \"float32\")[..., tf.newaxis]\n",
    "    img = tf.image.resize(img, (IMAGE_SIZE, IMAGE_SIZE))\n",
    "    return (img - 127.5) / 127.5  # scale to [-1, 1] to match the tanh output\n",
    "\n",
    "\n",
    "train = (\n",
    "    tf.data.Dataset.from_tensor_slices(x_all)\n",
    "    .shuffle(10_000, seed=SEED)\n",
    "    .batch(BATCH_SIZE, drop_remainder=True)\n",
    "    .map(preprocess, num_parallel_calls=tf.data.AUTOTUNE)\n",
    "    .repeat()\n",
    "    .prefetch(tf.data.AUTOTUNE)\n",
    ")\n",
    "\n",
    "rng = np.random.default_rng(SEED)\n",
    "real_sample = preprocess(x_all[rng.choice(len(x_all), N_DIVERSITY, replace=False)]).numpy()\n",
    "REAL_DIVERSITY = mean_pairwise_distance(real_sample)\n",
    "print(f\"Real-data diversity (mean pairwise L2 over {N_DIVERSITY} images): {REAL_DIVERSITY:.2f}\")\n",
    "\n",
    "plot_grid(real_sample[:25], 5, 5, title=\"Real Fashion-MNIST (64x64)\",\n",
    "          path=os.path.join(OUTPUT_DIR, \"real_samples.png\"))"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "id": "cell-08",
   "metadata": {},
   "source": [
    "## 2. Critic and generator (Foster's architecture)"
   ]
  },
  {
   "cell_type": "code",
   "id": "cell-09",
   "metadata": {},
   "source": [
    "def build_critic():\n",
    "    critic_input = layers.Input(shape=(IMAGE_SIZE, IMAGE_SIZE, CHANNELS))\n",
    "    x = layers.Conv2D(64, kernel_size=4, strides=2, padding=\"same\")(critic_input)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Conv2D(128, kernel_size=4, strides=2, padding=\"same\")(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Dropout(0.3)(x)\n",
    "    x = layers.Conv2D(256, kernel_size=4, strides=2, padding=\"same\")(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Dropout(0.3)(x)\n",
    "    x = layers.Conv2D(512, kernel_size=4, strides=2, padding=\"same\")(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Dropout(0.3)(x)\n",
    "    x = layers.Conv2D(1, kernel_size=4, strides=1, padding=\"valid\")(x)\n",
    "    critic_output = layers.Flatten()(x)  # unbounded score, no sigmoid\n",
    "    return models.Model(critic_input, critic_output, name=\"critic\")\n",
    "\n",
    "\n",
    "def build_generator():\n",
    "    generator_input = layers.Input(shape=(Z_DIM,))\n",
    "    x = layers.Reshape((1, 1, Z_DIM))(generator_input)\n",
    "    x = layers.Conv2DTranspose(512, kernel_size=4, strides=1, padding=\"valid\", use_bias=False)(x)\n",
    "    x = layers.BatchNormalization(momentum=0.9)(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Conv2DTranspose(256, kernel_size=4, strides=2, padding=\"same\", use_bias=False)(x)\n",
    "    x = layers.BatchNormalization(momentum=0.9)(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Conv2DTranspose(128, kernel_size=4, strides=2, padding=\"same\", use_bias=False)(x)\n",
    "    x = layers.BatchNormalization(momentum=0.9)(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    x = layers.Conv2DTranspose(64, kernel_size=4, strides=2, padding=\"same\", use_bias=False)(x)\n",
    "    x = layers.BatchNormalization(momentum=0.9)(x)\n",
    "    x = layers.LeakyReLU(0.2)(x)\n",
    "    generator_output = layers.Conv2DTranspose(\n",
    "        CHANNELS, kernel_size=4, strides=2, padding=\"same\", activation=\"tanh\"\n",
    "    )(x)\n",
    "    return models.Model(generator_input, generator_output, name=\"generator\")\n",
    "\n",
    "\n",
    "build_critic().summary()\n",
    "build_generator().summary()"
   ],
   "execution_count": null,
   "outputs": []
