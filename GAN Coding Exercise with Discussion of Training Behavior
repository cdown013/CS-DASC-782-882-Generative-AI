    "import os, time, json, csv, platform\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "from tensorflow.keras import layers, models, callbacks, optimizers, metrics\n",
    "\n",
    "SEED = 42\n",
    "keras.utils.set_random_seed(SEED)  # seeds Python, NumPy and TensorFlow\n",
    "\n",
    "gpus = tf.config.list_physical_devices(\"GPU\")\n",
    "for gpu in gpus:\n",
    "    try:\n",
    "        tf.config.experimental.set_memory_growth(gpu, True)\n",
    "    except RuntimeError:\n",
    "        pass\n",
    "\n",
    "print(\"Python    \", platform.python_version())\n",
    "print(\"TensorFlow\", tf.__version__)\n",
    "print(\"Keras     \", keras.__version__)\n",
    "print(\"GPUs      \", gpus if gpus else \"none -- training on CPU will be very slow\")\n",
    "for gpu in gpus:\n",
    "    print(\"          \", tf.config.experimental.get_device_details(gpu).get(\"device_name\", gpu.name))"
