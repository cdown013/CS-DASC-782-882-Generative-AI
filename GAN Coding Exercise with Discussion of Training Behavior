    "def smooth(y, window):\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    if len(y) < window:\n",
    "        return y\n",
    "    return np.convolve(y, np.ones(window) / window, mode=\"valid\")\n",
    "\n",
    "\n",
    "def plot_losses(monitor, tag, window=50):\n",
    "    steps = np.asarray(monitor.log[\"g_step\"])\n",
    "    panels = [\n",
    "        (\"c_loss\", \"Critic total loss  (c_wass_loss + GP_WEIGHT * c_gp)\"),\n",
    "        (\"c_wass_loss\", \"Critic Wasserstein term  E[D(fake)] - E[D(real)]\"),\n",
    "        (\"c_gp\", \"Gradient penalty  E[(||grad D|| - 1)^2]\"),\n",
    "        (\"g_loss\", \"Generator loss  -E[D(fake)]\"),\n",
    "    ]\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(12, 7), sharex=True)\n",
    "    for ax, (key, title) in zip(axes.flat, panels):\n",
    "        y = np.asarray(monitor.log[key])\n",
    "        ax.plot(steps, y, alpha=0.35, lw=0.8, label=\"per epoch (2 steps)\")\n",
    "        ys = smooth(y, window)\n",
    "        if len(ys) < len(y):\n",
    "            ax.plot(steps[window - 1:], ys, lw=1.8, label=f\"{window}-epoch moving mean\")\n",
    "        ax.set_title(title, fontsize=10)\n",
    "        ax.grid(alpha=0.3)\n",
    "    for ax in axes[1]:\n",
    "        ax.set_xlabel(\"generator step\")\n",
    "    axes[0, 0].legend(fontsize=8)\n",
    "    fig.suptitle(f\"WGAN-GP losses on Fashion-MNIST ({tag})\")\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(os.path.join(OUTPUT_DIR, tag, \"loss_curves.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_evolution(monitor, tag, n_images=8, n_rows=6):\n",
    "    steps = sorted(monitor.snapshots)\n",
    "    picks = np.unique(np.linspace(0, len(steps) - 1, min(n_rows, len(steps))).round().astype(int))\n",
    "    chosen = [steps[i] for i in picks]\n",
    "    fig, axes = plt.subplots(len(chosen), n_images, figsize=(n_images * 1.3, len(chosen) * 1.4), squeeze=False)\n",
    "    for r, step in enumerate(chosen):\n",
    "        images = to_unit(monitor.snapshots[step][:n_images])\n",
    "        for c in range(n_images):\n",
    "            ax = axes[r, c]\n",
    "            ax.imshow(images[c].squeeze(), cmap=\"gray\", vmin=0, vmax=1)\n",
    "            ax.set_xticks([])\n",
    "            ax.set_yticks([])\n",
    "        axes[r, 0].set_ylabel(f\"step {step}\", rotation=0, ha=\"right\", va=\"center\", fontsize=9)\n",
    "    fig.suptitle(f\"Same latent vectors over training ({tag})\")\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(os.path.join(OUTPUT_DIR, tag, \"sample_evolution.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_diversity(monitor, tag):\n",
    "    fig, ax = plt.subplots(figsize=(7, 3.5))\n",
    "    ax.plot(monitor.diversity[\"g_step\"], monitor.diversity[\"value\"], marker=\"o\", ms=3, label=\"generated\")\n",
    "    ax.axhline(REAL_DIVERSITY, color=\"k\", ls=\"--\", lw=1, label=\"real data\")\n",
    "    ax.set_xlabel(\"generator step\")\n",
    "    ax.set_ylabel(\"mean pairwise L2 distance\")\n",
    "    ax.set_title(f\"Sample diversity ({tag})\")\n",
    "    ax.grid(alpha=0.3)\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(os.path.join(OUTPUT_DIR, tag, \"diversity.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def summarize(monitor, last=500):\n",
    "    print(f\"Statistics over the last {min(last, len(monitor.log['g_step']))} epochs vs. the whole run:\")\n",
    "    for k in LOSS_KEYS:\n",
    "        y = np.asarray(monitor.log[k])\n",
    "        tail = y[-last:]\n",
    "        print(f\"  {k:12s} mean {tail.mean():9.3f}  std {tail.std():8.3f}   |  overall min {y.min():9.3f}  max {y.max():9.3f}\")\n",
    "    d = monitor.diversity[\"value\"]\n",
    "    print(f\"Diversity: start {d[0]:.2f}, final {d[-1]:.2f}, real {REAL_DIVERSITY:.2f} \"\n",
    "          f\"(final / real = {d[-1] / REAL_DIVERSITY:.2f})\")"
   ],
