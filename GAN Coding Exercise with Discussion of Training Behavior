   "source": [
    "## 4. Training monitor and training function"
   ]
  },
  {
   "cell_type": "code",
   "id": "cell-13",
   "metadata": {},
   "source": [
    "LOSS_KEYS = [\"c_loss\", \"c_wass_loss\", \"c_gp\", \"g_loss\"]\n",
    "\n",
    "\n",
    "class TrainingMonitor(callbacks.Callback):\n",
    "    \"\"\"Logs the losses after every epoch. Every `sample_every` epochs it saves a\n",
    "    5x5 grid from fixed latent vectors and measures sample diversity.\"\"\"\n",
    "\n",
    "    def __init__(self, out_dir, sample_every):\n",
    "        super().__init__()\n",
    "        self.out_dir = out_dir\n",
    "        self.sample_every = sample_every\n",
    "        self.z_fixed = tf.random.normal((25, Z_DIM))\n",
    "        self.z_div = tf.random.normal((N_DIVERSITY, Z_DIM))\n",
    "        self.log = {k: [] for k in [\"g_step\"] + LOSS_KEYS + [\"seconds\"]}\n",
    "        self.snapshots = {}\n",
    "        self.diversity = {\"g_step\": [], \"value\": []}\n",
    "\n",
    "    def on_train_begin(self, logs=None):\n",
    "        self.t0 = time.time()\n",
    "        self._sample(0)\n",
    "\n",
    "    def on_epoch_end(self, epoch, logs=None):\n",
    "        step = (epoch + 1) * STEPS_PER_EPOCH\n",
    "        values = {k: float(logs[k]) for k in LOSS_KEYS}\n",
    "        self.log[\"g_step\"].append(step)\n",
    "        for k in LOSS_KEYS:\n",
    "            self.log[k].append(values[k])\n",
    "        self.log[\"seconds\"].append(time.time() - self.t0)\n",
    "        if (epoch + 1) % self.sample_every == 0:\n",
    "            div = self._sample(step)\n",
    "            print(f\"step {step:6d} | c_loss {values['c_loss']:8.3f} | c_wass {values['c_wass_loss']:8.3f}\"\n",
    "                  f\" | gp {values['c_gp']:6.3f} | g_loss {values['g_loss']:8.3f}\"\n",
    "                  f\" | diversity {div:5.2f} (real {REAL_DIVERSITY:.2f})\"\n",
    "                  f\" | {(time.time() - self.t0) / 60:5.1f} min\")\n",
    "\n",
    "    def on_train_end(self, logs=None):\n",
    "        with open(os.path.join(self.out_dir, \"losses.csv\"), \"w\", newline=\"\") as f:\n",
    "            writer = csv.writer(f)\n",
    "            writer.writerow(list(self.log))\n",
    "            writer.writerows(zip(*self.log.values()))\n",
    "        with open(os.path.join(self.out_dir, \"diversity.csv\"), \"w\", newline=\"\") as f:\n",
    "            writer = csv.writer(f)\n",
    "            writer.writerow(list(self.diversity))\n",
    "            writer.writerows(zip(*self.diversity.values()))\n",
    "\n",
    "    def _sample(self, step):\n",
    "        generator = self.model.generator\n",
    "        images = generator(self.z_fixed, training=False).numpy()\n",
    "        self.snapshots[step] = images\n",
    "        plot_grid(images, 5, 5, title=f\"step {step}\", show=False,\n",
    "                  path=os.path.join(self.out_dir, f\"samples_step_{step:06d}.png\"))\n",
    "        div = mean_pairwise_distance(generator(self.z_div, training=False).numpy())\n",
    "        self.diversity[\"g_step\"].append(step)\n",
    "        self.diversity[\"value\"].append(div)\n",
    "        return div\n",
    "\n",
    "\n",
    "def train_wgangp(epochs, critic_steps=CRITIC_STEPS, gp_weight=GP_WEIGHT, tag=\"baseline\"):\n",
    "    keras.utils.set_random_seed(SEED)\n",
    "    out_dir = os.path.join(OUTPUT_DIR, tag)\n",
    "    os.makedirs(out_dir, exist_ok=True)\n",
    "\n",
    "    model = WGANGP(build_critic(), build_generator(), Z_DIM, critic_steps, gp_weight)\n",
    "    model.compile(\n",
    "        c_optimizer=optimizers.Adam(learning_rate=LEARNING_RATE, beta_1=ADAM_BETA_1, beta_2=ADAM_BETA_2),\n",
    "        g_optimizer=optimizers.Adam(learning_rate=LEARNING_RATE, beta_1=ADAM_BETA_1, beta_2=ADAM_BETA_2),\n",
    "    )\n",
    "    monitor = TrainingMonitor(out_dir, SAMPLE_EVERY)\n",
    "\n",
    "    t0 = time.time()\n",
    "    model.fit(train, epochs=epochs, steps_per_epoch=STEPS_PER_EPOCH, callbacks=[monitor], verbose=0)\n",
    "    minutes = (time.time() - t0) / 60\n",
    "\n",
    "    model.generator.save_weights(os.path.join(out_dir, \"generator.weights.h5\"))\n",
    "    model.critic.save_weights(os.path.join(out_dir, \"critic.weights.h5\"))\n",
    "    info = {\n",
    "        \"tag\": tag, \"seed\": SEED, \"epochs\": epochs, \"steps_per_epoch\": STEPS_PER_EPOCH,\n",
    "        \"generator_steps\": epochs * STEPS_PER_EPOCH,\n",
    "        \"critic_steps_total\": epochs * STEPS_PER_EPOCH * critic_steps,\n",
    "        \"batch_size\": BATCH_SIZE, \"critic_steps_per_g_step\": critic_steps, \"gp_weight\": gp_weight,\n",
    "        \"learning_rate\": LEARNING_RATE, \"adam_betas\": [ADAM_BETA_1, ADAM_BETA_2], \"z_dim\": Z_DIM,\n",
    "        \"dataset\": \"Fashion-MNIST (70k train+test, resized to 64x64)\",\n",
    "        \"minutes\": round(minutes, 1),\n",
    "        \"tensorflow\": tf.__version__, \"keras\": keras.__version__, \"python\": platform.python_version(),\n",
    "        \"gpus\": [tf.config.experimental.get_device_details(g).get(\"device_name\", g.name) for g in gpus],\n",
    "    }\n",
    "    with open(os.path.join(out_dir, \"run_info.json\"), \"w\") as f:\n",
    "        json.dump(info, f, indent=2)\n",
    "    print(f\"\\nFinished {tag}: {info['generator_steps']} generator steps in {minutes:.1f} min\")\n",
    "    return model, monitor"
   ],
   "execution_count": null,
   "outputs": []
  },
